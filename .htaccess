Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:src|scripts|source-assets|node_modules|dist|\.git)(?:/|$) - [F,NC]
RewriteRule ^(?:package(?:-lock)?\.json|README\.md|\.hostinger-output\.json)$ - [F,NC]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(?:css|js)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(?:webp|avif|png|jpe?g|svg|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
